# ===== 必填 =====
# Poe API key，从 https://poe.com/api_key 获取（需要 Poe 订阅）
SYSTEM_TOKEN=your_poe_api_key
# 客户端访问本服务时使用的令牌（configure.sh 会自动生成强随机值，请勿使用弱口令）
CUSTOM_TOKEN=your_custom_token

# ===== 可选：监听地址 =====
# 需要从其他机器访问用 0.0.0.0；仅本机访问建议 127.0.0.1
HOST=0.0.0.0
PORT=39527

# ===== 可选：模型映射（单行 JSON，OpenAI 模型名 -> Poe bot 名） =====
MODEL_MAPPING='{"gpt-5.4":"gpt-5.4","gpt-4o":"gpt-4o","gpt-4o-mini":"gpt-4o-mini","claude-sonnet-4.6":"claude-sonnet-4.6","claude-opus-4.8":"claude-opus-4.8","gemini-3.5-flash":"gemini-3.5-flash","gemini-3.1-pro":"gemini-3.1-pro","grok-4.6":"grok-4.6","dall-e-3":"gpt-image-2","nano-banana-2":"nano-banana-2"}'

# ===== 可选：CORS 允许的来源，逗号分隔；留空 = 不启用 CORS（纯 API 客户端无需开启） =====
ALLOWED_ORIGINS=

# ===== 可选：出站代理（PROXY_TYPE 填 http 或 socks；全部留空 = 直连） =====
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ===== 可选：工具 schema 兼容模式 =====
# 某些客户端发送的复杂 JSON Schema 被 Poe 拒绝时设为 true（会把 allOf/联合类型降级）
POE_SIMPLIFY_SCHEMAS=false

# ===== 可选：工具调用模式 =====
# auto（默认）：优先走 Poe 原生工具协议，bot 不支持时自动降级为 prompt 仿真
# native：只用原生协议（bot 不支持 tools 时直接报错）
# emulate：只用 prompt 仿真（把工具 schema 注入提示词，解析模型输出的 JSON）
POE_TOOL_MODE=auto
# 已知不支持原生 tools 的 bot 名单（逗号分隔），带 tools 请求时直接用仿真模式，
# 跳过原生探测。可避免每次重启后两次失败调用的延迟和积分消耗
POE_EMULATE_BOTS=gemini-3.7-flash,gemini-3.6-flash
# 流式保活间隔（秒）：上游长时间无输出时发送 SSE 注释行防止客户端读超时断开
POE_KEEPALIVE_SECONDS=15
# 流超时保护：整个 Poe 请求的最大等待时间（秒），超时返回错误而非无限挂起
POE_STREAM_TIMEOUT=120
# 首个事件超时：Poe 连接后首个事件的等待时间（秒），防连接建立后无响应
POE_FIRST_EVENT_TIMEOUT=30
# 瞬态错误重试次数：遇到 BotError 等 Poe 后端偶发故障时的重试次数（0-3，默认 1）
POE_RETRY_COUNT=1

# ===== 可选：诊断日志（排障时临时开启，平时保持关闭） =====
# 设为 1 后在 log/app.log 输出 DIAG 前缀的详细日志（请求/事件计数/文本长度/异常详情，
# 仿真解析失败时含少量内容片段）。排查完记得改回 0 并重启。
POE_DEBUG_LOG=0
